@echo off
REM ==========================================
REM  WinToolKit CMD Version by Murdervan
REM  Version: 1.1.0
REM  Windows 10 / Windows 11
REM  CMD Launcher - PowerShell 5.1 compatible
REM ==========================================
setlocal
title WinToolKit CMD Version

REM Request administrator rights if needed.
net session >nul 2>&1
if not "%errorlevel%"=="0" (
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

set "SCRIPT_DIR=%~dp0"
set "WINTOOLKIT_ROOT=%SCRIPT_DIR%"
set "WINTOOLKIT_SCRIPT_TARGET=%SCRIPT_DIR%WORKFLOW\WinToolKit.ps1"

REM Bring the elevated console to the foreground and restore it if minimized.
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

echo.
echo  WinToolKit - Checking the latest published GitHub release...
echo  The PowerShell script is run in memory; WORKFLOW is not downloaded automatically.
echo.

REM Online: run the latest published release in memory.
REM Offline: use WORKFLOW\WinToolKit.ps1 only if the user saved it from About.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "WT_EXIT=%errorlevel%"

echo.
if not "%WT_EXIT%"=="0" (
    echo  WinToolKit exited with code %WT_EXIT%.
    pause
)
exit /b %WT_EXIT%
